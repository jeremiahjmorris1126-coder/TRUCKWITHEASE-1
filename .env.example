# ==============================================================================
# TRUCKWITHEASE // Production & Development Environment Configuration
# ==============================================================================

# 1. RUNTIME & SERVER
# Port to listen on (automatically injected by Google Cloud Run, default: 8080)
PORT=8080
NODE_ENV=production
# APP_URL: Domain or service URL (e.g. https://truckwithease.com or https://morrishive.com)
APP_URL="https://truckwithease.com"

# 2. GOOGLE CLOUD PLATFORM & FIRESTORE
# GCP Project ID hosting Firestore and Cloud Run
GCP_PROJECT_ID="project-f0634118-be01-44f7-b36"
# Firestore database ID ('app-builder-38a26d99' or '(default)')
FIRESTORE_DATABASE_ID="app-builder-38a26d99"

# 3. AI & WEATHER ENGINE (Google Generative AI)
# Required for real-time weather hazard search grounding
GEMINI_API_KEY="your-gemini-api-key"

# 4. MULTI-TENANT CARRIER SECURITY
# Optional API secret required for mutating routes when multi-tenant enforcement is active
CARRIER_API_SECRET="your-carrier-api-secret-key"

# 5. TWILIO SMS & DISPATCH TELEPHONY
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
TWILIO_FROM_NUMBER="+15551234567"
TWILIO_DISPATCH_TO_NUMBER="+15557654321"
TWILIO_ALLOWED_TO_NUMBERS="+15559876543"

# 6. FLEET TELEMATICS INTEGRATIONS (Samsara, Motive, Geotab)
# When keys are omitted, the server operates seamlessly in normalized mock fallback mode.
SAMSARA_API_TOKEN="samsara_api_token_here"
MOTIVE_API_KEY="motive_api_key_here"
GEOTAB_SESSION_ID="geotab_session_here"
