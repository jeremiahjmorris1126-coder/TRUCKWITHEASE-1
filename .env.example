# ==============================================================================
# TRUCKWITHEASE // Production & Development Environment Configuration
# ==============================================================================

# 1. RUNTIME & SERVER
# Port to listen on (automatically injected by Google Cloud Run, default: 8080)
PORT=8080
NODE_ENV=production
# APP_URL: Domain or service URL (e.g. https://truckwithease.com or https://morrishive.com)
APP_URL="https://truckwithease.com"

# 2. GOOGLE CLOUD PLATFORM & FIRESTORE
# GCP Project ID hosting Firestore and Cloud Run
GCP_PROJECT_ID="project-f0634118-be01-44f7-b36"
# Firestore database ID ('app-builder-38a26d99' or '(default)')
FIRESTORE_DATABASE_ID="app-builder-38a26d99"

# 3. AI & WEATHER ENGINE (Google Generative AI)
# Required for real-time weather hazard search grounding
GEMINI_API_KEY="your-gemini-api-key"

# 4. MULTI-TENANT CARRIER SECURITY
# Optional API secret required for mutating routes when multi-tenant enforcement is active
CARRIER_API_SECRET="your-carrier-api-secret-key"

# 5. TWILIO SMS & DISPATCH TELEPHONY
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
TWILIO_FROM_NUMBER="+15551234567"
TWILIO_DISPATCH_TO_NUMBER="+15557654321"
TWILIO_ALLOWED_TO_NUMBERS="+15559876543"

# 6. ELD / TELEMATICS (Samsara, Motive, Geotab) — read-only
# Data is never fabricated: a provider without credentials returns nothing, and a
# failing provider is reported as ERROR in GET /api/telematics/status.
# Verify a live connection with:  bun scripts/verifyEldConnection.ts
#
# Fleet that owns these ELD credentials. Only users of this fleet (and owners)
# receive ELD data from the API. REQUIRED for any ELD data to be served.
TELEMATICS_FLEET_ID="FLEET1"
# Samsara: API token with "Read Vehicle Statistics" + "Read ELD Hours of Service"
SAMSARA_API_TOKEN="samsara_api_token_here"
# SAMSARA_API_BASE="https://api.eu.samsara.com"   # EU accounts only
# Motive: API key from Motive Dashboard > Admin > API
MOTIVE_API_KEY="motive_api_key_here"
# Geotab (MyGeotab): service account with read access
GEOTAB_DATABASE="your_database"
GEOTAB_USERNAME="api-user@yourcompany.com"
GEOTAB_PASSWORD="geotab_password_here"
# GEOTAB_SERVER="my.geotab.com"
# GPSTab ordering: users order the ELD directly from GPSTab's store.
# Defaults to https://gpstab.com/product-category/eld/ — set this to your GPSTab
# partner/referral link when you have one (https only).
# GPSTAB_ORDER_URL="https://gpstab.com/..."
# Dev/tests only: serve flagged demo fixtures when no provider is configured (ignored in production)
# TELEMATICS_DEMO_DATA="true"

# 7. TRUCK PARKING (state DOT TPIMS real-time feeds)
# JSON array, one entry per state. Register with each state DOT for a free API key;
# the key goes inside the URLs. Unset = Parking page says "not connected yet".
# TPIMS_FEEDS='[{"state":"KS","dynamicUrl":"https://...","staticUrl":"https://..."}]'

# 8. WEIGH STATION BYPASS (enrollment links only; the app never signals bypass)
# PREPASS_ENROLL_URL="https://prepass.com/"            # default
# DRIVEWYZE_ENROLL_URL="https://drivewyze.com/preclear/" # default
