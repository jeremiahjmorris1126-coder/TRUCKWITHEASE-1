# GEMINI_API_KEY: Required for Gemini AI API calls & Search Grounding.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or Cloud Run secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. https://morrishive.com).
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CARRIER_API_SECRET: Optional secret token for backend API authentication and multi-tenant authorization.
# When set, mutating API calls must supply 'Authorization: Bearer <token>' or 'x-api-key: <token>'.
CARRIER_API_SECRET="your-carrier-api-secret-key"

# PORT: Server listening port (default: 3000)
PORT=3000

# Twilio SMS dispatch. Configure these in the server's secret manager or .env.
# The destination is intentionally configured server-side; request bodies cannot choose a recipient.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
TWILIO_FROM_NUMBER="+15551234567"
TWILIO_DISPATCH_TO_NUMBER="+15557654321"
# Optional comma-separated E.164 allowlist for direct one-to-one driver messages.
TWILIO_ALLOWED_TO_NUMBERS="+15559876543"
